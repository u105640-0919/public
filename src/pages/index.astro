---
import Layout from '../layouts/Layout.astro';
import { getPath } from '../utils/path';
---

<Layout title="◆◇ Astro★i-mode ﾊﾟｰｸ ◇◆" description="iモード全盛期のガラケーWebサイトを完全再現したAstroテンプレートです。">
  <!-- アクセスカウンターセクション -->
  <div class="counter-box">
    <div class="counter-text">
      あなたは <span class="counter-digits">004810</span> 人目の旅人です<br />
      (今日: <span class="num">12</span> / 昨日: <span class="num">89</span>)
    </div>
    <div class="kiriban-info">
      ※ 5000踏んだ人はBBSで報告してﾈ!
    </div>
  </div>

  <hr />

  <!-- 管理人からの一言 -->
  <div class="message-box">
    <span class="icon">💬</span><b>管理人のひとこと</b><br />
    最近バイト忙しすぎﾜﾛﾀw 誰かメールして〜(*^^*)
  </div>

  <!-- 更新履歴 (What's New) -->
  <div class="section-title banner-pink">
    ★* 更新履歴 *★
  </div>
  <div class="news-list">
    <div>
      <span class="date">09/19</span> <span class="blink new-badge">★NEW★</span><br />
      <a href={getPath('/20260919_hello')}>日記を更新したよ！</a>
    </div>
    <div>
      <span class="date">09/18</span> サイト開設したお(・∀・)
    </div>
  </div>

  <!-- メインメニュー -->
  <div class="section-title banner-blue">
    ▼ ﾒｲﾝﾒﾆｭｰ ▼
  </div>
  <ul class="menu-list">
    <li>
      <span class="key-num">[1]</span>
      <a href={getPath('/about')} accesskey="1">自己紹介 (前略ﾌﾟﾛﾌ風)</a>
    </li>
    <li>
      <span class="key-num">[2]</span>
      <a href={getPath('/20260919_hello')} accesskey="2">管理人日記 (9/19更新)</a> <span class="blink new-tag">UP!</span>
    </li>
    <li>
      <span class="key-num">[3]</span>
      <a href="#bbs" accesskey="3">あしあとBBS (準備中)</a>
    </li>
    <li>
      <span class="key-num">[4]</span>
      <a href="#link" accesskey="4">お友達リンク集</a>
    </li>
    <li>
      <span class="key-num">[5]</span>
      <a href="mailto:admin@example.com" accesskey="5">管理人へ直メ</a>
    </li>
  </ul>

  <!-- 掲示板風の案内 -->
  <div class="section-title banner-orange" id="bbs">
    ■ 簡易BBS (足跡帳)
  </div>
  <div class="bbs-preview">
    <div class="bbs-item">
      <span class="bbs-num">[12]</span> <b>通りすがり</b> (09/19 01:23)<br />
      HP開設おめでとー！相互リンクしよ♪
    </div>
    <div class="bbs-item">
      <span class="bbs-num">[11]</span> <b>名無しさん</b> (09/18 23:45)<br />
      キリ番ゲットならず…orz また来ます！
    </div>
  </div>

  <hr class="dotted" />

  <!-- サイト利用上の注意 -->
  <div class="caution-box">
    <font color="#cc0000">【注意】</font><br />
    ・当サイトはパケ放題推奨です。<br />
    ・誹謗中傷、荒らしはアク禁にします(怒)<br />
    ・推奨ブラウザ: Docomo FOMA 900i/700i、504i以降
  </div>
</Layout>

<style>
  /* カウンター */
  .counter-box {
    text-align: center;
    background-color: #000000;
    color: #00ff00;
    padding: 6px;
    font-family: monospace;
    font-size: 11px;
    border: 2px inset #999999;
    margin-bottom: 6px;
  }

  .counter-digits {
    font-size: 16px;
    font-weight: bold;
    color: #ff0000;
    background-color: #ffffff;
    padding: 0 4px;
    border: 1px solid #666666;
    letter-spacing: 2px;
  }

  .num {
    color: #ffff00;
  }

  .kiriban-info {
    font-size: 10px;
    color: #00ffff;
    margin-top: 2px;
  }

  /* 管理人ひとこと */
  .message-box {
    background-color: #f0f8ff;
    border: 1px solid #b0c4de;
    padding: 4px 6px;
    font-size: 11px;
    margin-bottom: 8px;
  }

  /* 帯見出し */
  .section-title {
    font-size: 12px;
    font-weight: bold;
    padding: 3px 6px;
    margin: 8px 0 4px;
  }

  .banner-pink {
    background-color: #ff69b4;
    color: #ffffff;
  }

  .banner-blue {
    background-color: #0055aa;
    color: #ffffff;
  }

  .banner-orange {
    background-color: #ff8c00;
    color: #ffffff;
  }

  /* 更新履歴 */
  .news-list {
    font-size: 11px;
    padding: 2px 4px;
    line-height: 1.5;
  }

  .date {
    color: #666666;
  }

  .new-badge {
    color: #ff0000;
    font-weight: bold;
    font-size: 10px;
  }

  .new-tag {
    color: #ff0000;
    font-size: 10px;
    font-weight: bold;
  }

  /* メニュー */
  .menu-list {
    list-style: none;
    padding: 2px 4px;
  }

  .menu-list li {
    margin-bottom: 5px;
    font-size: 12px;
  }

  .key-num {
    font-weight: bold;
    color: #ff0055;
    margin-right: 2px;
  }

  /* BBS */
  .bbs-preview {
    background-color: #fafafa;
    border: 1px solid #dddddd;
    padding: 4px;
    font-size: 11px;
    margin-bottom: 6px;
  }

  .bbs-item {
    margin-bottom: 4px;
    padding-bottom: 4px;
    border-bottom: 1px dashed #e0e0e0;
    line-height: 1.3;
  }

  .bbs-item:last-child {
    border-bottom: none;
    margin-bottom: 0;
    padding-bottom: 0;
  }

  .bbs-num {
    color: #0055aa;
  }

  /* 注意事項 */
  .caution-box {
    font-size: 10px;
    color: #555555;
    background-color: #fffaf0;
    border: 1px solid #ffe4b5;
    padding: 4px 6px;
    margin: 8px 0;
    line-height: 1.4;
  }
</style>
