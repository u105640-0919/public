---
import Layout from '../layouts/Layout.astro';
import { getPath } from '../utils/path';

const profileItems = [
  { q: 'HN (ﾊﾝﾄﾞﾙﾈｰﾑ)', a: '★ｱｽﾄﾛたん★' },
  { q: '職業', a: '魔法戦士兼Web職人' },
  { q: '生年月日', a: '199X年 秘密' },
  { q: '血液型', a: '典型的なA型' },
  { q: '所持端末', a: 'Docomo P900i (カスタムジャケット装着)' },
  { q: '趣味', a: '3和音着メロ打ち込み、ネトサ' },
  { q: '好きな言葉', a: '「パケ死上等」「キリ番踏み逃げ禁止」' },
  { q: 'ひとこと', a: '足跡残していってね！直メも歓迎(*^o^*)' },
];
---

<Layout title="自己紹介 | 前略ﾌﾟﾛﾌ風" description="管理人のプロフィールページです。">
  <div class="about-page">
    <div class="title-banner">
      ◆* 前略ﾌﾟﾛﾌ風自己紹介 *◆
    </div>

    <div class="avatar-area">
      <div class="ascii-art">
        ( ^ω^) ﾌﾞｰﾝ<br />
        c( O┬O<br />
        (_)_)
      </div>
      <div class="caption">※ 管理人の自画像です</div>
    </div>

    <hr class="dotted" />

    <div class="profile-table">
      {profileItems.map((item) => (
        <div class="profile-row">
          <div class="profile-q">【{item.q}】</div>
          <div class="profile-a">{item.a}</div>
        </div>
      ))}
    </div>

    <hr />

    <div class="sub-banner">
      ■ 当サイトについて
    </div>
    <div class="site-desc">
      Astro v7で蘇る、古き良き2000年代初頭のiモード(ガラケー)体験をお届けするWebサイトです。<br /><br />
      フレームワークは最新の超高速Astroですが、見た目は完全にパケ死に怯えていたあの頃のままです。
    </div>

    <div class="back-link">
      <a href={getPath('/')}>← トップに戻る</a>
    </div>
  </div>
</Layout>

<style>
  .about-page {
    font-size: 12px;
  }

  .title-banner {
    background-color: #9932cc;
    color: #ffffff;
    font-weight: bold;
    padding: 3px 6px;
    text-align: center;
    margin-bottom: 6px;
  }

  .sub-banner {
    background-color: #2e8b57;
    color: #ffffff;
    font-weight: bold;
    padding: 3px 6px;
    margin: 8px 0 4px;
  }

  .avatar-area {
    text-align: center;
    padding: 6px;
    background-color: #f9f9f9;
    border: 1px dashed #cccccc;
    margin-bottom: 6px;
  }

  .ascii-art {
    font-family: monospace;
    font-size: 12px;
    line-height: 1.2;
    color: #333333;
  }

  .caption {
    font-size: 10px;
    color: #888888;
    margin-top: 4px;
  }

  .profile-table {
    margin: 6px 0;
  }

  .profile-row {
    margin-bottom: 6px;
  }

  .profile-q {
    font-weight: bold;
    color: #ff0055;
    font-size: 11px;
  }

  .profile-a {
    padding-left: 8px;
    color: #222222;
    font-size: 12px;
  }

  .site-desc {
    font-size: 11px;
    line-height: 1.5;
    background-color: #fafafa;
    padding: 6px;
    border: 1px solid #e0e0e0;
    margin-bottom: 10px;
  }

  .back-link {
    text-align: center;
    margin: 10px 0 4px;
  }
</style>
