---
import { getPath } from '../utils/path';

const currentYear = new Date().getFullYear();
---

<footer class="imode-footer">
  <hr class="rainbow" />

  <div class="nav-shortcuts">
    <a href={getPath('/')} accesskey="0">[0] ﾄｯﾌﾟへ戻る</a><br />
    <a href="#top">[#] ﾍﾟｰｼﾞ最上部▲</a>
  </div>

  <hr class="dotted" />

  <div class="footer-notice">
    <p>当ｻｲﾄはﾘﾝｸﾌﾘｰです★<br />(相互ﾘﾝｸ募集中!)</p>
    <p class="copyright">
      無断転載禁止<br />
      (c)2002-{currentYear} Astro Mobile.<br />
      Produced by Astro.js
    </p>
  </div>
</footer>

<style>
  .imode-footer {
    padding: 6px 8px 12px;
    font-size: 11px;
    text-align: center;
    background-color: #f5f5f5;
  }

  .nav-shortcuts {
    margin: 6px 0;
    line-height: 1.6;
  }

  .nav-shortcuts a {
    font-weight: bold;
  }

  .footer-notice {
    color: #666666;
    line-height: 1.4;
    margin-top: 6px;
  }

  .copyright {
    font-size: 10px;
    margin-top: 4px;
    color: #888888;
  }
</style>
