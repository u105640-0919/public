---
const currentYear = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="footer-container">
    <p>&copy; {currentYear} My Astro Site. Built with <a href="https://astro.build" target="_blank" rel="noopener noreferrer">Astro</a>.</p>
  </div>
</footer>

<style>
  .site-footer {
    background: #f9fafb;
    border-top: 1px solid #e5e7eb;
    margin-top: auto;
    padding: 2rem 1.5rem;
    text-align: center;
    color: #6b7280;
    font-size: 0.875rem;
  }

  .footer-container {
    max-width: 1024px;
    margin: 0 auto;
  }

  .site-footer a {
    color: #4f46e5;
    text-decoration: none;
  }

  .site-footer a:hover {
    text-decoration: underline;
  }
</style>
