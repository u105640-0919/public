---
import { getPath } from '../utils/path';

interface Props {
  siteTitle?: string;
}

const { siteTitle = 'Astro★i-mode' } = Astro.props;
---

<header class="imode-header">
  <!-- 電光掲示板風 marquee -->
  <div class="marquee-box">
    <marquee scrollamount="3" truespeed>
      ★☆★ ようこそ！{siteTitle}へ！ キリ番踏んだらBBSにカキコしてね(o^-')b ★☆★
    </marquee>
  </div>

  <div class="site-branding">
    <div class="sub-title">~*~ 宇宙最強MOBILE HP ~*~</div>
    <h1 class="main-title">
      <a href={getPath('/')}>◆◇ {siteTitle} ◇◆</a>
    </h1>
  </div>

  <hr class="dotted" />
</header>

<style>
  .imode-header {
    background-color: #ffffff;
  }

  .marquee-box {
    background-color: #ffffcc;
    color: #cc0000;
    font-size: 11px;
    padding: 2px 0;
    border-bottom: 1px dashed #cccccc;
  }

  .site-branding {
    text-align: center;
    padding: 8px 4px 4px;
  }

  .sub-title {
    font-size: 10px;
    color: #ff0099;
  }

  .main-title {
    font-size: 16px;
    margin: 2px 0;
  }

  .main-title a {
    color: #000088;
    text-decoration: none;
    font-weight: bold;
  }

  .main-title a:hover {
    color: #ff0000;
  }
</style>
